{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "pnpm --filter @shazam/drizzle db:migrate && pnpm turbo run build --filter=web",
  "functions": {
    "api/extract.py": {
      "maxDuration": 300,
      "memory": 2048,
      "excludeFiles": "{.next,node_modules,app,public,.turbo}/**"
    }
  }
}
